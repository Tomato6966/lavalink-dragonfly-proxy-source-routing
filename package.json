{
  "name": "lavalink-dragonfly-proxy-source-routing",
  "version": "1.1.0",
  "description": "High-performance native Bun Lavalink proxy with Dragonfly caching, source remapping, and Event Hub RPC",
  "main": "src/index.ts",
