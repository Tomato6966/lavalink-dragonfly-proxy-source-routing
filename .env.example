# Proxy listener and Lavalink-compatible client password
HOST=127.0.0.1
PORT=2332
PASSWORD=replace-with-a-long-random-secret

# Default playback/search backend
UPSTREAM_DEFAULT_URL=http://127.0.0.1:2333
UPSTREAM_DEFAULT_WS_URL=ws://127.0.0.1:2333/v4/websocket
UPSTREAM_DEFAULT_PASSWORD=replace-with-upstream-password
UPSTREAM_DEFAULT_ENCODING_SCOPE=lavalink-main
UPSTREAM_REQUEST_TIMEOUT_MS=3500

# Optional NodeLink node. Keep disabled until explicitly used by compatible routing policy.
UPSTREAM_NODELINK_ENABLED=false
UPSTREAM_NODELINK_URL=http://127.0.0.1:2334
UPSTREAM_NODELINK_WS_URL=ws://127.0.0.1:2334/v4/websocket
UPSTREAM_NODELINK_PASSWORD=replace-with-upstream-password
UPSTREAM_NODELINK_ENCODING_SCOPE=nodelink

# Dragonfly / Redis (leave password unset when the local instance has no AUTH)
DRAGONFLY_ENABLED=true
DRAGONFLY_URL=redis://127.0.0.1:6379
# DRAGONFLY_PASSWORD=
DRAGONFLY_COMMAND_TIMEOUT_MS=750
SEARCH_TTL=2678400
TRACK_TTL=2678400
LYRICS_TTL=604800
MAX_CACHED_ENTRIES=100000
MEMORY_CACHE_MAX_ENTRIES=1000
MEMORY_CACHE_TTL=604800
CACHE_TTL_JITTER=0.05

# Routing and optional metadata-only last resorts
MAX_RECURSION_DEPTH=6
ROUTE_LEARNING_ENABLED=true
ROUTE_LEARNING_TTL=1800
SPOTIFY_METADATA_TIMEOUT_MS=1800
DISTUBE_YTSR_ENABLED=true
DISTUBE_YTSR_TIMEOUT_MS=1800
FUZZY_SEARCH_ENABLED=false
FUZZY_SEARCH_THRESHOLD=0.9

# Event Hub workers must return real backend-produced encoded tracks
EVENT_HUB_ENABLED=true
EVENT_HUB_PATH=/proxy/events
EVENT_HUB_AUTH_TOKEN=replace-with-a-long-random-secret
EVENT_HUB_TIMEOUT_MS=2500
EVENT_HUB_ENCODING_SCOPE=lavalink-main

LOG_DEBUG=false
LOG_HITS=true
LOG_MISSES=true
LOG_ROUTES=true
LOG_FALLBACKS=true
