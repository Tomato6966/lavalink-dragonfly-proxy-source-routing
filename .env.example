# ==============================================================================
# LAVALINK DRAGONFLY PROXY — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust the values according to your environment.
# 
# ⚠️ SECURITY NOTICE:
# Never commit `.env` files containing real production passwords or credentials.
# Keep all secret tokens and passwords strong and randomized.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK LISTENER CONFIGURATION
# ------------------------------------------------------------------------------
# HTTP port the proxy listens on for Lavalink client connections (Discord bots)
PORT=2332

# Network interface IP to bind to ("0.0.0.0" for all interfaces, "127.0.0.1" for localhost only)
HOST=0.0.0.0

# Master authorization password that Discord music bots must provide in the "Authorization" header
PASSWORD=replace-with-a-long-random-secret

# Total timeout in milliseconds for upstream REST requests before triggering fallback cascades
UPSTREAM_REQUEST_TIMEOUT_MS=3500

# Maximum payload size in bytes accepted from upstream before skipping caching / parsing (default: 8MB)
MAX_LOAD_RESULT_BYTES=8388608

# Maximum concurrent in-flight loadtracks requests before shedding load with 503 Retry-After
MAX_IN_FLIGHT_REQUESTS=1000

# Maximum buffered WebSocket messages per client connection before applying backpressure
WS_MAX_QUEUE_MESSAGES=256

# Maximum queued WebSocket byte size per client connection (default: 1MB)
WS_MAX_QUEUE_BYTES=1048576

# Primary Upstream Node to route player sessions, voice updates, decodes, and WebSocket passthrough
# Options: "default", "nodelink_node", or any custom key defined in upstreams
PRIMARY_PLAYBACK_NODE="default"

# ------------------------------------------------------------------------------
# 2. DRAGONFLY / REDIS CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# Master toggle to enable/disable Dragonfly/Redis caching
DRAGONFLY_ENABLED=true

# Connection URI to Dragonfly / Redis server (Dragonfly default port is often 6666, Redis is 6379)
DRAGONFLY_URL=redis://127.0.0.1:6666

# Authentication password for Dragonfly / Redis (leave commented or empty if unauthenticated)
# DRAGONFLY_PASSWORD=replace-with-dragonfly-password

# Key prefix used in Redis to isolate proxy cache data
DRAGONFLY_KEY_PREFIX=mivator:lavalink

# Socket command timeout in milliseconds for Dragonfly read/write operations
DRAGONFLY_COMMAND_TIMEOUT_MS=750

# Time-To-Live in seconds for search query results (2,678,400s = 31 days)
SEARCH_TTL=2678400

# Time-To-Live in seconds for resolved track metadata and decoded tokens (31 days)
TRACK_TTL=2678400

# Time-To-Live in seconds for timed lyrics results (604,800s = 7 days)
LYRICS_TTL=604800

# Maximum total entries tracked in cache index (0 = unlimited)
MAX_CACHED_ENTRIES=100000

# Maximum entries stored in hot in-process L1 memory cache
MEMORY_CACHE_MAX_ENTRIES=1000

# Maximum memory in bytes allocated for hot L1 cache (32MB = 33554432)
MEMORY_CACHE_MAX_BYTES=33554432

# Time-To-Live in seconds for hot L1 memory entries (7 days)
MEMORY_CACHE_TTL=604800

# Maximum serialized byte size for a single cache entry; larger payloads bypass cache (4MB)
CACHE_MAX_ENTRY_BYTES=4194304

# Random percentage jitter added to TTLs to prevent simultaneous cache expiry stampedes (0.05 = 5%)
CACHE_TTL_JITTER=0.05

# Enable fuzzy text similarity matching to serve cache hits on minor typos / accents
FUZZY_SEARCH_ENABLED=false

# Minimum similarity ratio (0.0 to 1.0) required for a fuzzy search cache hit (0.9 = 90%)
FUZZY_SEARCH_THRESHOLD=0.9

# ------------------------------------------------------------------------------
# 3. EVENT HUB WORKER RPC GATEWAY
# ------------------------------------------------------------------------------
# Enable external worker WebSocket gateway for custom fallback scrapers
EVENT_HUB_ENABLED=true

# URL pathname where EventHub worker clients connect via WebSocket
EVENT_HUB_PATH=/proxy/events

# Secret token required for worker daemons to authenticate with the proxy
EVENT_HUB_AUTH_TOKEN=replace-with-a-long-random-secret

# Maximum execution time in milliseconds for an EventHub worker task
EVENT_HUB_TIMEOUT_MS=3500

# Lavalink track encoding scope for tracks produced by Event Hub workers
EVENT_HUB_ENCODING_SCOPE=lavalink-main

# ------------------------------------------------------------------------------
# 4. REMAPPING, CASCADE ROUTING & INTELLIGENT RESOLUTION
# ------------------------------------------------------------------------------
# Master switch for query remapping, search optimization, and cascading failovers
REMAPPING_ENABLED=true

# Maximum number of fallback hops allowed per search query before returning 502/empty
MAX_RECURSION_DEPTH=4

# Enable automatic route learning to skip failed cascades on repeated queries
ROUTE_LEARNING_ENABLED=true

# Time-To-Live in seconds for learned fast-path routes (1800s = 30 minutes)
ROUTE_LEARNING_TTL=1800

# Timeout in milliseconds for direct Spotify metadata extraction via oEmbed / API
SPOTIFY_METADATA_TIMEOUT_MS=1800

# Enable DisTube YouTube scraper resolver as a headless fallback
DISTUBE_YTSR_ENABLED=true

# Timeout in milliseconds for DisTube YouTube scraper queries
DISTUBE_YTSR_TIMEOUT_MS=1800

# Multi-Language Search Re-Ranker (BM25, Dice bigram & Jaro-Winkler noise demotion)
SEARCH_RERANKING_ENABLED=true

# Intelligent YTM -> Deezer Search Bridge (queries YTM popularity, resolves Deezer audio)
DEEZER_YTM_BRIDGE_ENABLED=true

# Source Masking ("Source Illusion" - standardizes track sourceName to requested query platform)
MASK_SOURCE_TO_REQUESTED=true

# ------------------------------------------------------------------------------
# 5. UPSTREAM NODES CONFIGURATION
# ------------------------------------------------------------------------------
# --- Primary Lavalink Node (default) ---
UPSTREAM_DEFAULT_URL=http://127.0.0.1:2333
UPSTREAM_DEFAULT_WS_URL=ws://127.0.0.1:2333/v4/websocket
UPSTREAM_DEFAULT_PASSWORD=replace-with-upstream-password
UPSTREAM_DEFAULT_ENCODING_SCOPE=lavalink-main
UPSTREAM_DEFAULT_TIMEOUT_MS=3500
UPSTREAM_DEFAULT_FAILURE_THRESHOLD=5
UPSTREAM_DEFAULT_CIRCUIT_RESET_MS=15000

# --- Secondary NodeLink Node (nodelink_node) ---
UPSTREAM_NODELINK_ENABLED=false
UPSTREAM_NODELINK_URL=http://127.0.0.1:2334
UPSTREAM_NODELINK_WS_URL=ws://127.0.0.1:2334/v4/websocket
UPSTREAM_NODELINK_PASSWORD=replace-with-upstream-password
UPSTREAM_NODELINK_ENCODING_SCOPE=lavalink-main
UPSTREAM_NODELINK_TIMEOUT_MS=3500
UPSTREAM_NODELINK_FAILURE_THRESHOLD=5
UPSTREAM_NODELINK_CIRCUIT_RESET_MS=15000

# ------------------------------------------------------------------------------
# 6. LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
# Output verbose debug logs including WebSocket opcodes and payload sizes
LOG_DEBUG=false

# Output log entry whenever a request hits L1 memory or Dragonfly Redis cache
LOG_HITS=true

# Output log entry on cache misses
LOG_MISSES=true

# Output route remapping and cascade journey traces in console
LOG_ROUTES=true

# Output fallback trigger logs explaining why an upstream was failed over
LOG_FALLBACKS=true
