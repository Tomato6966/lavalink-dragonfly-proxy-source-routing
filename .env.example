# Lavalink Dragonfly Proxy Environment Configuration

# Server
PORT=2332
HOST=0.0.0.0
PASSWORD=youshallnotpass

# Dragonfly / Redis Cache
DRAGONFLY_ENABLED=true
DRAGONFLY_URL=redis://127.0.0.1:6379
DRAGONFLY_KEY_PREFIX=lavalink_proxy
SEARCH_TTL=259200
TRACK_TTL=86400
LYRICS_TTL=604800
MAX_CACHED_ENTRIES=100000

# Event Hub RPC
EVENT_HUB_ENABLED=true
EVENT_HUB_PATH=/proxy/events
EVENT_HUB_AUTH_TOKEN=youshallnotpass
EVENT_HUB_TIMEOUT_MS=3000

# Cascade & Remapping
MAX_RECURSION_DEPTH=4

# Upstream Nodes
UPSTREAM_DEFAULT_URL=http://127.0.0.1:2333
UPSTREAM_DEFAULT_WS_URL=ws://127.0.0.1:2333/v4/websocket
UPSTREAM_DEFAULT_PASSWORD=youshallnotpass

UPSTREAM_NODELINK_URL=http://127.0.0.1:2334
UPSTREAM_NODELINK_WS_URL=ws://127.0.0.1:2334/v4/websocket
UPSTREAM_NODELINK_PASSWORD=youshallnotpass

# Logging
LOG_DEBUG=false
LOG_HITS=true
LOG_MISSES=true
LOG_ROUTES=true
LOG_FALLBACKS=true
